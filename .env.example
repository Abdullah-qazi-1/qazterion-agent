# ==============================================================================
# QAZTERION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
#
# Instructions:
# 1. Copy this file to '.env' in your development workspace.
# 2. Add your free or commercial API key(s) below.
# 3. For the Desktop Application: Keys entered via the UI or Onboarding Wizard
#    are automatically encrypted using Windows DPAPI and stored in your local
#    OS Keystore, so creating a .env file is completely OPTIONAL.
#
# ==============================================================================

# --- LLM Provider API Keys (Physical Key Pooling: add numbered keys as needed) ---
GROQ_KEY_1=
GROQ_KEY_2=

GEMINI_KEY_1=
GEMINI_KEY_2=

MISTRAL_KEY_1=
MISTRAL_KEY_2=

OPENROUTER_KEY_1=

DEEPSEEK_KEY_1=

# --- LiteLLM Proxy Configuration ---
# Master key used by the local proxy (auto-generated if left empty)
LITELLM_MASTER_KEY=sk-local-qazterion-master-key-32chars

# --- Agent & Workspace Settings ---
# Enable optional local semantic embeddings (requires sentence-transformers)
QAZTERION_ENABLE_EMBEDDINGS=false

# Auto-approve Python virtual environment creation in target workspaces
QAZTERION_AUTO_SETUP=false

# Explicit Python executable path (optional override)
# QZ_PYTHON_PATH=C:\Users\username\AppData\Local\Programs\Python\Python313\python.exe
